{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/client",
      "destination": "/"
    },
    {
      "source": "/client/",
      "destination": "/"
    },
    {
      "source": "/proposal/:id",
      "destination": "/"
    },
    {
      "source": "/proposal/:id/",
      "destination": "/"
    },
    {
      "source": "/pay/complete",
      "destination": "/"
    },
    {
      "source": "/pay/complete/",
      "destination": "/"
    },
    {
      "source": "/pay/cancelled",
      "destination": "/"
    },
    {
      "source": "/pay/cancelled/",
      "destination": "/"
    },
    {
      "source": "/sign/:id",
      "destination": "/"
    },
    {
      "source": "/sign/:id/",
      "destination": "/"
    },
    {
      "source": "/pay/:id",
      "destination": "/"
    },
    {
      "source": "/pay/:id/",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/client",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/proposal/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sign/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pay/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/book-now",
      "destination": "/#booking",
      "permanent": true
    },
    {
      "source": "/shows",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/#booking",
      "permanent": true
    },
    {
      "source": "/book",
      "destination": "/#booking",
      "permanent": true
    },
    {
      "source": "/music",
      "destination": "/#music",
      "permanent": true
    },
    {
      "source": "/event/5248906/651902398/supperclub-saturdays-feat-charmin-greene",
      "destination": "/events",
      "permanent": true
    },
    {
      "source": "/event/5375522/665726162/ladies-r-b-kickback-concert-valentine-s-day-edition-w-h-town-feat-charmin-greene-ginuwine-dru-hill-bobby-v-and-more",
      "destination": "/events",
      "permanent": true
    }
  ]
}
